{
  "name": "@esthernandez/vibe-sec-cli",
  "version": "0.6.0",
  "description": "Headless security scanner for vibe-coded apps — tier-aware secret detection with severity tiers and CI-safe exit codes. Self-contained bundle of the Vibe Sec audit engine; defers to gitleaks/trufflehog when present, in-house Layer A/B/C fallback otherwise. Zero runtime dependencies.",
  "type": "module",
  "author": "626Labs LLC",
  "license": "MIT",
  "homepage": "https://github.com/estevanhernandez-stack-ed/vibe-sec#readme",
  "bugs": "https://github.com/estevanhernandez-stack-ed/vibe-sec/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/estevanhernandez-stack-ed/vibe-sec.git",
    "directory": "packages/vibe-sec-cli"
  },
  "bin": {
    "vibe-sec": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "tsup",
    "test": "node dist/cli.js --help",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@esthernandez/vibe-sec": "workspace:*",
    "@types/node": "^20.14.0",
    "rimraf": "^5.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "security",
    "secret-scanner",
    "vibe-coding",
    "api-keys",
    "leak-detection",
    "ci",
    "626labs"
  ],
  "publishConfig": {
    "access": "public"
  }
}
