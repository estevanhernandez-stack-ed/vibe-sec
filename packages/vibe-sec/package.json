{
  "name": "@esthernandez/vibe-sec",
  "version": "0.9.0",
  "description": "Tier-aware security audit + orchestration layer for vibe-coded apps. Defers to gitleaks/OSV-Scanner/Semgrep when present, falls back to an in-house baseline when absent, and owns the classification, severity calibration, four-band report, fix routing, and threat-model synthesis on top. A Claude Code plugin.",
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "Estevan Hernandez",
    "url": "https://626labs.dev"
  },
  "homepage": "https://github.com/estevanhernandez-stack-ed/vibe-sec#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/estevanhernandez-stack-ed/vibe-sec.git",
    "directory": "packages/vibe-sec"
  },
  "bugs": {
    "url": "https://github.com/estevanhernandez-stack-ed/vibe-sec/issues"
  },
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "security",
    "vibe-coding",
    "audit",
    "secrets",
    "orchestration",
    "626labs"
  ],
  "bin": {
    "vibe-sec": "./dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    ".claude-plugin",
    "README.md",
    "framework.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist coverage"
  },
  "dependencies": {
    "@babel/parser": "^7.29.3",
    "@babel/types": "^7.29.0"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.5",
    "@types/node": "^20.14.0",
    "rimraf": "^5.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
